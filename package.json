{
  "name": "plock-app",
  "private": true,
  "version": "2.0.0",
  "author": "Plock Team",
  "description": "Plock — 플래너 · 다이어리 · 가계부",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "emulators": "npx --yes firebase-tools emulators:start --only auth,firestore",
    "firebase:login": "npx --yes firebase-tools login",
    "deploy": "npm run build && npx --yes firebase-tools deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "pretendard": "^1.3.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
