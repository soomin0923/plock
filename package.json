{
  "name": "plock-app",
  "private": true,
  "version": "2.0.0",
  "author": "Plock Team",
  "description": "Plock — 플래너 · 다이어리 · 가계부",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "emulators": "npx --yes firebase-tools emulators:start --only auth,firestore",
    "firebase:login": "npx --yes firebase-tools login",
    "deploy": "npm run build && npx --yes firebase-tools deploy --only hosting,firestore:rules",
    "eval": "tsx eval/run.ts",
    "eval:dev": "tsx eval/run.ts --data eval/dataset.csv --strict",
    "eval:test": "tsx eval/run.ts --data eval/holdout.csv --strict --blind",
    "eval:replay": "tsx eval/replay.ts",
    "mcp": "tsx mcp/server.ts",
    "mcp:test": "tsx mcp/e2e.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "pretendard": "^1.3.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-admin": "^14.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  }
}
