rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read/write for all application collections in this private studio environment
    match /users/{userId} {
      allow read, write: if true;
    }

    match /userData/{userId} {
      allow read, write: if true;
    }

    match /systemBackups/{backupId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
